# Скопируйте этот файл в .env.local и впишите значения из консоли Firebase
# (Project settings → General → Your apps → Web app → SDK setup and configuration → Config).
# Это открытая конфигурация веб-приложения, не секретный ключ; доступ ограничивают правила firestore.rules.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
